<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Details Page</title>
</head>

<body>
    <h2>
        <%= product.name %>
    </h2>
    <ul>
        <li>
            Price : <%= product.price %>
        </li>
        <li>
            category : <a href="/products?category=<%= product.category %>">
                <%= product.category %>
            </a>
        </li>
    </ul>
    <a href="/products">Back to All Products</a>
    <br>
    <a href="/products/<%= product._id %>/edit">Edit Product</a>
    <form method="post" action="/products/<%= product._id %>?_method=delete">
        <button>Delete</button>
    </form>
</body>

</html>